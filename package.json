{
  "name": "epstein-archive",
  "private": true,
  "version": "22.3.5",
  "description": "Epstein Archive Analyzer",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:clean": "rm -rf node_modules/.vite && vite --force",
    "build": "vite build",
    "prebuild:prod": "pnpm --filter @epstein/db build && pnpm schema:hash:check && pnpm type-check:server && pnpm check:schema-identifiers && pnpm check:knip-baseline && bash scripts/ci_pg_nuclear_gates.sh && STRICT_DESIGN_TOKENS=1 node --import tsx/esm scripts/check_design_token_usage.ts",
    "build:prod": "pnpm build:client && pnpm build:server",
    "postbuild:prod": "pnpm check:budget",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && pnpm check:server-runtime-imports",
    "type-check:server": "tsc -p tsconfig.server.json --noEmit",
    "start": "NODE_ENV=production RAW_CORPUS_BASE_PATH=./data node dist/server.js",
    "server": "pnpm exec tsx src/server.ts",
    "api": "pnpm exec tsx src/server.ts",
    "preview": "vite preview",
    "go:prod": "tsx scripts/go_prod.ts",
    "snapshot:export": "tsx scripts/export_dashboard_snapshot.ts",
    "db:migrate:pg": "tsx scripts/pg_migrate.ts && tsx scripts/pg_analyze_after_migrate.ts",
    "db:backfill:pg": "tsx scripts/pg_backfill.ts",
    "semantic:backfill": "tsx scripts/backfill_semantic_embeddings.ts",
    "provenance:backfill": "tsx scripts/backfill_document_provenance.ts",
    "passages:backfill": "tsx scripts/backfill_evidence_passages.ts",
    "titles:backfill": "tsx scripts/backfill_document_titles.ts",
    "risk:recalculate": "tsx scripts/recalculate_entity_risk.ts",
    "db:analyze": "tsx scripts/pg_analyze_after_migrate.ts",
    "seed:structure": "tsx scripts/ensure_structure.ts",
    "seed:minimal": "tsx scripts/seed_minimal.ts",
    "verify": "tsx scripts/verify_ops.ts && pnpm test:bundle-smoke",
    "verify:live-cutover": "tsx scripts/verify_live_cutover.ts",
    "verify:entity-quality": "tsx scripts/verify_entity_quality_gates.ts",
    "db:sync-vip-entities": "tsx scripts/sync_vip_entities.ts",
    "db:quarantine-junk-entities": "tsx scripts/quarantine_junk_entities.ts --apply",
    "verify:asset-graph": "tsx scripts/verify_asset_graph.ts",
    "seed:katie-videos": "KJ_VIDEO_ROOT=./data/media/videos/KatieJohnson tsx scripts/ingest_katie_videos.ts",
    "ingest:intelligence": "tsx scripts/ingest_intelligence.ts",
    "pipeline:ingest": "tsx scripts/unified_pipeline.ts --mode ingest",
    "pipeline:full": "tsx scripts/unified_pipeline.ts --mode full",
    "pipeline:list-stages": "tsx scripts/unified_pipeline.ts --list-stages",
    "pipeline:backfill": "BATCH_SIZE=3 tsx scripts/unified_pipeline.ts --mode backfill",
    "pipeline:backfill:enrichment": "BATCH_SIZE=8 tsx scripts/unified_pipeline.ts --mode backfill --stage ai-enrichment",
    "pipeline:backfill:text-first": "PIPELINE_SKIP_STAGES=vlm-visuals BATCH_SIZE=8 tsx scripts/unified_pipeline.ts --mode backfill",
    "pipeline:backfill:vlm-slice": "VLM_BACKFILL_MAX_MEDIA=200 BATCH_SIZE=3 tsx scripts/unified_pipeline.ts --mode backfill --stage vlm-visuals",
    "local:db:up": "docker compose up -d postgres",
    "local:db:down": "docker compose down",
    "local:setup": "pnpm local:db:up && pnpm db:migrate:pg && pnpm seed:minimal",
    "local:smoke": "tsx scripts/local_smoke.ts",
    "pipeline:backfill:protected": "./scripts/run_protected.sh pipeline:backfill",
    "media:thumbnails:backfill:protected": "./scripts/run_protected.sh media:thumbnails:backfill",
    "media:sascha-tiktok:backfill": "tsx scripts/backfill_sascha_tiktok_video.ts",
    "black-book:enrich": "tsx scripts/enrich_black_book.ts",
    "media:thumbnails:backfill": "tsx scripts/backfill_thumbnails.ts",
    "media:provenance:backfill": "tsx scripts/backfill_extracted_media_provenance.ts",
    "media:classification:backfill": "tsx scripts/backfill_media_visual_classification.ts",
    "media:catalog:normalize": "tsx scripts/normalize_media_catalog.ts",
    "media:release:enrich": "pnpm media:classification:backfill -- --apply --all && pnpm media:catalog:normalize -- --apply",
    "media:release:audit": "node --import tsx/esm scripts/media_catalog_release.ts audit",
    "media:release:export": "node --import tsx/esm scripts/media_catalog_release.ts export",
    "media:release:import": "node --import tsx/esm scripts/media_catalog_release.ts import",
    "media:release:verify": "node --import tsx/esm scripts/media_catalog_release.ts verify",
    "lint": "eslint . --ext .ts,.tsx",
    "precheck": "bash scripts/strict_prechecks.sh --full",
    "precheck:staged": "bash scripts/strict_prechecks.sh --staged",
    "check:boundaries": "node scripts/check_client_server_boundary.mjs",
    "check:dead-schema-surfaces": "tsx scripts/check_dead_schema_surfaces.ts",
    "check:duplicate-indexes": "tsx scripts/check_duplicate_indexes.ts",
    "check:schema-identifiers": "tsx scripts/check_forbidden_schema_identifiers.ts",
    "check:seed-conflict-policy": "node --import tsx/esm scripts/check_seed_conflict_policy.ts",
    "check:test-hygiene": "node --import tsx/esm scripts/check_test_hygiene.ts",
    "check:hygiene": "bash scripts/check_hygiene.sh",
    "check:budget": "node --import tsx/esm scripts/check_bundle_budget.ts",
    "check:select-star": "node --import tsx/esm scripts/check_select_star.ts",
    "check:design-tokens": "node --import tsx/esm scripts/check_design_token_usage.ts",
    "check:design-tokens:strict": "STRICT_DESIGN_TOKENS=1 node --import tsx/esm scripts/check_design_token_usage.ts",
    "check:design-tokens:baseline": "STRICT_DESIGN_TOKENS=1 WRITE_STRICT_BASELINE=1 node --import tsx/esm scripts/check_design_token_usage.ts",
    "check:shared-component-drift": "tsx scripts/check_shared_component_drift.ts",
    "check:server-runtime-imports": "tsx scripts/check_server_runtime_imports.ts",
    "ops:pm2-cluster-cutover": "bash scripts/pm2_cluster_cutover.sh",
    "audit:design-system": "node --import tsx/esm scripts/audit_design_system_usage.ts",
    "check:design-system-audit": "STRICT_DESIGN_SYSTEM_AUDIT=1 node --import tsx/esm scripts/audit_design_system_usage.ts",
    "audit:data-integrity": "node --import tsx/esm scripts/data_integrity_audit.ts",
    "check:deploy-certify": "tsx scripts/deploy_certify.ts",
    "check:query-plan": "tsx scripts/check_query_plan.ts",
    "check:knip-baseline": "tsx scripts/check_knip_baseline.ts",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "token:check": "tsx scripts/token_compliance.ts",
    "test:smoke": "tsx scripts/smoke-tests.ts",
    "test:email:smoke": "tsx scripts/email_smoke.ts",
    "test:contracts": "playwright test tests/api-dto-contract.spec.ts --project=chromium --workers=1",
    "test:route-sync": "playwright test tests/route-ui-sync.spec.ts --project=chromium --workers=1",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run src/test/repositories.integration.test.ts",
    "deploy:prod": "./deploy.sh",
    "audit:pg": "bash scripts/run_audit_suite.sh",
    "hygiene:clean": "bash scripts/cleanup_llm_artifacts.sh",
    "ci:pg:nuclear": "bash scripts/ci_pg_nuclear_gates.sh",
    "db:check": "node -e 'const { Client } = require(\"pg\"); const client = new Client({ connectionString: process.env.DATABASE_URL }); client.connect().then(() => { console.log(\"✅ DB OK\"); client.end(); process.exit(0); }).catch((e) => { console.error(\"❌ DB Fail:\", e.message); process.exit(1); });'",
    "db:compute:significance": "tsx scripts/compute_document_significance.ts",
    "schema:hash:check": "tsx scripts/pg_schema_hash.ts check",
    "schema:hash:update": "tsx scripts/pg_schema_hash.ts update",
    "prepare": "husky",
    "test": "playwright test",
    "test:bundle-smoke": "pnpm build:prod && playwright test --config playwright.config.bundle.ts",
    "test:bundle-smoke:only": "node --import tsx/esm scripts/run_bundle_smoke.ts",
    "test:ci-budgets": "CI=true playwright test tests/ci-budgets.spec.ts --project=chromium",
    "check:release-trust": "node --import tsx/esm scripts/release_trust_gate.ts",
    "check:release-metadata": "node --import tsx/esm scripts/release_metadata_guard.ts"
  },
  "dependencies": {
    "@epstein/db": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/node": "^10.55.0",
    "@sentry/react": "^10.55.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/quoted-printable": "^1.0.2",
    "@vladmandic/face-api": "^1.7.15",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "clsx": "^2.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.0",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "date-fns": "^3.3.1",
    "diff": "^8.0.3",
    "dotenv": "^16.4.5",
    "exif-parser": "^0.1.12",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^11.0.8",
    "fuse.js": "^7.4.0",
    "glob": "^13.0.6",
    "helmet": "^8.2.0",
    "html-entities": "^2.6.0",
    "html-to-text": "^9.0.5",
    "isomorphic-dompurify": "^3.2.0",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "mailparser": "^3.9.9",
    "multer": "^2.0.1",
    "node-cache": "^5.1.2",
    "open": "^11.0.0",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "quoted-printable": "^1.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^2.0.5",
    "react-leaflet": "^4.2.1",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.16.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^1.8.10",
    "react-window-infinite-loader": "^2.0.1",
    "recharts": "^2.12.3",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "toobusy-js": "^0.5.1",
    "tsx": "^4.22.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@esbuild/linux-arm64": "0.25.12",
    "@playwright/test": "^1.60.0",
    "@rollup/rollup-linux-arm64-gnu": "4.53.3",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/express": "^5.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/toobusy-js": "^0.5.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "knip": "^6.14.2",
    "lint-staged": "^16.2.7",
    "node-pg-migrate": "^8.0.4",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^6.0.5",
