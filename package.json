    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/server/db/postgres/migrations/*.{js,sql}": [
      "pnpm schema:hash:update"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "brace-expansion": "^5.0.6",
      "lodash": "^4.18.1",
      "minimatch": "^10.2.5",
      "nodemailer": "^9.0.1",
      "postcss": "^8.5.12",
      "qs": "^6.15.2",
      "tar": "^7.5.13",
      "undici": "^6.21.0",
      "jsdom": "24.1.3",
      "rollup": "^4.59.0",
      "flatted": "^3.4.2",
      "picomatch": "^4.0.4",
      "yaml": "^2.8.3",
      "ip-address": "^10.1.1",
      "ajv": "^6.14.0",
      "zod": "^4.4.3",
      "dompurify": "^3.4.11",
      "ws": "^8.21.0",
      "piscina": "^4.9.3",
      "form-data": "^4.0.6",
      "js-yaml": "^4.2.0"
    },
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "sharp",
      "tesseract.js"
    ]
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
