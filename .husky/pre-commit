#!/bin/sh
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"

# Fast gates — format, lint, types, and targeted static checks.
# Scoped to staged files where possible so this stays under ~10s.

# ── 1. Format + lint auto-fix on staged files ────────────────────────────────
pnpm exec lint-staged || exit 1

# ── 2. Strict staged pre-checks ───────────────────────────────────────────────
pnpm run precheck:staged || { echo "❌ Strict pre-checks failed."; exit 1; }

# ── 3. TypeScript ─────────────────────────────────────────────────────────────
pnpm type-check || { echo "❌ TypeScript errors — fix before committing."; exit 1; }
