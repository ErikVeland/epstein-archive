# Database Configuration
# Postgres
DATABASE_URL=postgresql://epstein:epstein@localhost:5432/epstein_archive
POSTGRES_USER=epstein
POSTGRES_PASSWORD=epstein
POSTGRES_DB=epstein_archive

# API Configuration
API_PORT=3012

# Security
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# File Upload Limits
MAX_FILE_SIZE=50MB
MAX_FILES_PER_UPLOAD=10

# Cache Configuration
CACHE_TTL=3600

# Forensic integrity switches
# Disable public remote proxy fallback in production (only allow in dev with explicit opt-in)
PUBLIC_REMOTE_FILE_FALLBACK=false
# Fail closed when audit logging cannot be written
AUDIT_FAIL_CLOSED=true
# Allow historical migration ledger repair (dangerous; only for controlled one-off recovery)
ALLOW_MIGRATION_LEDGER_REPAIR=false
# Allow AI to rewrite canonical content_refined (never enable in production)
ALLOW_AI_CONTENT_REWRITE=false

# Monitoring
# REQUIRED in production. Without this, uncaught exceptions and unhandled
# rejections are logged locally only — no alerting or error dashboard.
# The server will emit a WARN log on every boot if this is missing in production.
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN).
SENTRY_DSN=your-sentry-dsn-here
# Client-side Sentry (build-time — must be prefixed VITE_ to be embedded by Vite)
VITE_SENTRY_DSN=your-sentry-dsn-here
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_VERSION=$npm_package_version
# Playwright contract/integration test token (optional — skip auth tests if absent)
PW_ADMIN_TOKEN=
# Run DB integration tests (requires DATABASE_URL pointing to a live Postgres instance)
RUN_INTEGRATION=
ANALYTICS_ID=your-analytics-id-here

# Backup Configuration
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups
