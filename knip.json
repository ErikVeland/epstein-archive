{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs}!", "src/test/**/*.test.ts", "tests/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}", "tests/**/*.{ts,tsx}"],
      "ignoreDependencies": ["pino-pretty", "node-pg-migrate"]
    },
    "packages/db": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts"]
    }
  }
}
