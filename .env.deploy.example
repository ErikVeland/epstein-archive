# Production deploy connection settings.
# Copy to .env.deploy.local for local deploys. The .local file is intentionally
# ignored because it may contain machine-specific paths or private hostnames.

# Remote application host reached by deploy.sh over SSH.
EPSTEIN_PROD_HOST=194.195.248.217

# Remote Unix user that owns the production checkout and PM2 process.
EPSTEIN_PROD_SSH_USER=svc_epstein

# Remote checkout path. deploy.sh expects this tree to contain the production
# .env file with DATABASE_URL and runtime secrets.
EPSTEIN_PROD_PATH=/home/svc_epstein/epstein-archive

# Local path to the private key used for production SSH access.
EPSTEIN_PROD_SSH_KEY_PATH=${HOME}/.ssh/id_epstein_prod_ed25519

# Public origin used by post-deploy live-data verification.
EPSTEIN_PUBLIC_ORIGIN=https://epstein.academy

# Local-only canary port used on the production host during staged cutover.
EPSTEIN_CANARY_PORT=3013
